# Backend Environment Variables
# Copy this file to .env and update the values

# Database Configuration
MONGO_URL=mongodb://localhost:27017/kinaura_wellness
DB_NAME=test_database

# Security
SECRET_KEY=your_secret_key_here_minimum_32_characters_long
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# AI Integration
EMERGENT_LLM_KEY=your_emergent_llm_key_here

# Payment Processing
STRIPE_API_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Calendar Integration
GOOGLE_SERVICE_ACCOUNT_PATH=/app/backend/google-service-account.json

# Firebase Push Notifications
FIREBASE_SERVICE_ACCOUNT_PATH=/app/backend/firebase-service-account.json

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CONTACT_EMAIL=admin@yourdomain.com

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Environment
NODE_ENV=development
DEBUG=true