# KinAura Production Environment Configuration
# Used for production builds and App Store releases

# Backend API Configuration
REACT_APP_BACKEND_URL=https://api.kinaura.med

# Supabase Configuration (Production)
REACT_APP_SUPABASE_URL=https://your-production-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-production-supabase-anon-key

# Firebase Configuration (Production Project)
REACT_APP_FIREBASE_API_KEY=your-production-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=kinaura-prod.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=kinaura-prod
REACT_APP_FIREBASE_STORAGE_BUCKET=kinaura-prod.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=987654321098
REACT_APP_FIREBASE_APP_ID=1:987654321098:web:fedcba654321
REACT_APP_FIREBASE_VAPID_KEY=your-production-vapid-key

# Production Features
REACT_APP_ENABLE_WEBSOCKET=true
REACT_APP_ENABLE_DEBUG_LOGS=false

# Social Login Configuration (Production)
REACT_APP_APPLE_CLIENT_ID=com.kinauramed.kinaura
REACT_APP_FACEBOOK_APP_ID=your-production-facebook-app-id
REACT_APP_GOOGLE_WEB_CLIENT_ID=your-production-google-client-id

# Environment Indicator
REACT_APP_ENVIRONMENT=production

# Security Configuration
REACT_APP_ENFORCE_HTTPS=true
REACT_APP_CSP_ENABLED=true